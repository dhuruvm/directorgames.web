{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "BASE_PATH=/ PORT=3000 pnpm --filter @workspace/director-games run build",
  "outputDirectory": "artifacts/director-games/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}